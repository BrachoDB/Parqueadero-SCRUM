{
  "openapi": "3.1.0",
  "info": {
    "title": "API del Parqueadero",
    "description": "Cálculo de tarifa por tiempo y tipo de vehículo.",
    "version": "1.0.0"
  },
  "paths": {
    "/salud": {
      "get": {
        "summary": "Salud",
        "description": "Endpoint sencillo de salud para verificar que la API está viva.",
        "operationId": "salud_salud_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Salud Salud Get"
                }
              }
            }
          }
        }
      }
    },
    "/calcular-tarifa": {
      "post": {
        "summary": "Calcular Tarifa",
        "description": "Calcula el costo del parqueadero por tiempo transcurrido.",
        "operationId": "calcular_tarifa_calcular_tarifa_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalculoResponse"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales Basic Auth ausentes o inválidas."
          },
          "403": {
            "description": "Credenciales válidas, pero el rol no permite la operación."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ]
      }
    },
    "/calcular-tarifa-vehiculo": {
      "post": {
        "summary": "Calcular Tarifa Vehiculo",
        "description": "Calcula el costo usando la tarifa diferencial según el tipo de vehículo.",
        "operationId": "calcular_tarifa_vehiculo_calcular_tarifa_vehiculo_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculoVehiculoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalculoResponse"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales Basic Auth ausentes o inválidas."
          },
          "403": {
            "description": "Credenciales válidas, pero el rol no permite la operación."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ]
      }
    },
    "/tarifas": {
      "get": {
        "summary": "Listar Tarifas",
        "description": "Lista las tarifas diferenciales por tipo de vehículo (RF-02).",
        "operationId": "listar_tarifas_tarifas_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response Listar Tarifas Tarifas Get"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales Basic Auth ausentes o inválidas."
          },
          "403": {
            "description": "Credenciales válidas, pero el rol no permite la operación."
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CalculoRequest": {
        "properties": {
          "hora_entrada": {
            "type": "string",
            "format": "date-time",
            "title": "Hora Entrada",
            "description": "Hora de entrada del vehículo."
          },
          "hora_salida": {
            "type": "string",
            "format": "date-time",
            "title": "Hora Salida",
            "description": "Hora de salida del vehículo."
          },
          "valor_hora": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Valor Hora",
            "description": "Valor de la tarifa por hora."
          },
          "minutos_minimos": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Minutos Minimos",
            "description": "Cobro mínimo en minutos (por defecto 0).",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "hora_entrada",
          "hora_salida",
          "valor_hora"
        ],
        "title": "CalculoRequest",
        "description": "Cuerpo de la petición para calcular una tarifa."
      },
      "CalculoResponse": {
        "properties": {
          "minutos_estadia": {
            "type": "integer",
            "title": "Minutos Estadia"
          },
          "minutos_cobrados": {
            "type": "integer",
            "title": "Minutos Cobrados"
          },
          "horas_cobradas": {
            "type": "integer",
            "title": "Horas Cobradas"
          },
          "costo": {
            "type": "string",
            "title": "Costo"
          }
        },
        "type": "object",
        "required": [
          "minutos_estadia",
          "minutos_cobrados",
          "horas_cobradas",
          "costo"
        ],
        "title": "CalculoResponse",
        "description": "Respuesta con el desglose del cobro."
      },
      "CalculoVehiculoRequest": {
        "properties": {
          "tipo_vehiculo": {
            "$ref": "#/components/schemas/TipoVehiculo",
            "description": "Tipo de vehículo (carro, moto, camioneta, bus, camion)."
          },
          "hora_entrada": {
            "type": "string",
            "format": "date-time",
            "title": "Hora Entrada",
            "description": "Hora de entrada del vehículo."
          },
          "hora_salida": {
            "type": "string",
            "format": "date-time",
            "title": "Hora Salida",
            "description": "Hora de salida del vehículo."
          }
        },
        "type": "object",
        "required": [
          "tipo_vehiculo",
          "hora_entrada",
          "hora_salida"
        ],
        "title": "CalculoVehiculoRequest",
        "description": "Petición que identifica el vehículo por su tipo (RF-02)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TipoVehiculo": {
        "type": "string",
        "enum": [
          "carro",
          "moto",
          "camioneta",
          "bus",
          "camion"
        ],
        "title": "TipoVehiculo",
        "description": "Tipos de vehículo soportados por el parqueadero."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBasic": {
        "type": "http",
        "scheme": "basic"
      }
    }
  }
}
