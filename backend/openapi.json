{
  "openapi": "3.1.0",
  "info": {
    "title": "Sistema de Gestión de Parqueaderos",
    "description": "API REST para el control de acceso y gestión de vehículos en parqueadero.",
    "contact": {
      "name": "Equipo Scrum - Sprint 1"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/vehiculos/entrada": {
      "post": {
        "tags": [
          "Registro de Vehículos"
        ],
        "summary": "RF-01: Registrar entrada de vehículo",
        "description": "**RF-01**: Registra la entrada de un vehículo al parqueadero.\n- Captura automáticamente la **hora exacta de entrada** (server-side).\n- Valida formato de placa colombiana.\n- Verifica que el vehículo no tenga ya un registro activo.",
        "operationId": "registrar_entrada_api_v1_vehiculos_entrada_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistroEntradaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistroResponse"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales Basic Auth ausentes o inválidas."
          },
          "403": {
            "description": "Credenciales válidas, pero el rol no permite la operación."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ]
      }
    },
    "/api/v1/vehiculos/{placa}/tarifa": {
      "get": {
        "tags": [
          "Tarifas & Rendimiento"
        ],
        "summary": "RF-01 Rendimiento: Consultar tarifa acumulada (≤ 2s SLA)",
        "description": "**RF-01 Rendimiento**: Muestra la tarifa acumulada de un vehículo.\n- Garantía SLA: tiempo de respuesta ≤ **2000 ms**.\n- Usa índice `idx_placa_estado` para búsqueda O(log n).\n- La tarifa base se obtiene desde caché en memoria O(1).",
        "operationId": "consultar_tarifa_api_v1_vehiculos__placa__tarifa_get",
        "security": [
          {
            "HTTPBasic": []
          }
        ],
        "parameters": [
          {
            "name": "placa",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Placa"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TarifaConsultaResponse"
                }
              }
            }
          },
          "401": {
            "description": "Credenciales Basic Auth ausentes o inválidas."
          },
          "403": {
            "description": "Credenciales válidas, pero el rol no permite la operación."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/vehiculos/salida": {
      "post": {
        "tags": [
          "Registro de Vehículos"
        ],
        "summary": "RF-03: Registrar salida y calcular cobro total",
        "description": "**RF-03**: Registra la salida, calcula tiempo parqueado y cobra según tarifa.\n- Cálculo: `ceil(minutos / 60) * tarifa_hora`\n- Se cobra fracción de hora completa (hora iniciada = hora cobrada).",
        "operationId": "registrar_salida_api_v1_vehiculos_salida_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistroSalidaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Credenciales Basic Auth ausentes o inválidas."
          },
          "403": {
            "description": "Credenciales válidas, pero el rol no permite la operación."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ]
      }
    },
